# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/output/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# local codex environment metadata
.codex/environments/
.playwright-cli/
.superpowers/

# local one-off publish scripts
scripts/update-cover.mjs
scripts/update-published-post-content.mjs

# python cache (e.g. local tools under .shared)
__pycache__/
*.pyc

.vercel
.env*.local
